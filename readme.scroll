// Knowbooks Media
//
// Every place Knowbooks (or Breck) shows up in the media: radio, podcasts,
// TV, print, and the web. Newest first by default.
//
// Nothing heavy loads up front: cards are just lazy-loaded images, and a
// recording only downloads when someone presses play. Appearances live in
// media.scroll as a ScrollSet (data, not markup); this page reads the
// compiled media.json and generates a card per row, so adding an appearance
// is a data edit in media.scroll, not an HTML edit here.

buildHtml
permalink index.html
title Knowbooks Media
description Every place Knowbooks appears in the media.
keywords knowbooks, media, press, appearances, breck, scroll
baseUrl https://media.knowbooks.com/
editBaseUrl https://github.com/breck7/media.knowbooks.com/blob/main/

metaTags

css
 :root {
   color-scheme: dark;
   --kb-bg: #0a0d12;
   --kb-card: #121924;
   --kb-card-hover: #17212e;
   --kb-border: rgba(255, 255, 255, 0.08);
   --kb-text: #e8eef6;
   --kb-muted: #8b98a9;
   --kb-accent: #7cc4ff;
 }
 * { box-sizing: border-box; }
 [hidden] { display: none !important; }
 html { background: var(--kb-bg); }
 body {
   margin: 0;
   min-height: 100vh;
   color: var(--kb-text);
   background:
     radial-gradient(900px 520px at 12% -12%, rgba(124, 196, 255, 0.13), transparent 60%),
     radial-gradient(820px 520px at 100% 0%, rgba(179, 136, 255, 0.11), transparent 58%),
     var(--kb-bg);
   font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
   line-height: 1.5;
   -webkit-font-smoothing: antialiased;
 }
 .kb-hero { max-width: 1200px; margin: 0 auto; padding: 76px 24px 8px; text-align: center; }
 .kb-kicker { text-decoration: none; margin: 0; text-transform: uppercase; letter-spacing: 0.26em; font-size: 0.72rem; font-weight: 600; color: var(--kb-accent); }
 .kb-hero h1 {
   margin: 14px 0 0;
   font-size: clamp(2.5rem, 7vw, 4rem);
   line-height: 1.02;
   letter-spacing: -0.035em;
   font-weight: 700;
   background: linear-gradient(115deg, #ffffff 5%, #a9c7ff 52%, #c9b3ff 95%);
   -webkit-background-clip: text;
   background-clip: text;
   color: transparent;
 }
 .kb-sub { max-width: 620px; margin: 18px auto 0; color: var(--kb-muted); font-size: 1.02rem; }
 .kb-toolbar { max-width: 1200px; margin: 0 auto; padding: 28px 24px 14px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
 .kb-count { color: var(--kb-muted); font-size: 0.9rem; }
 .kb-sort {
   appearance: none;
   border: 1px solid var(--kb-border);
   background: var(--kb-card);
   color: var(--kb-text);
   padding: 9px 16px;
   border-radius: 999px;
   font: inherit;
   font-size: 0.88rem;
   cursor: pointer;
   transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
 }
 .kb-sort:hover { background: var(--kb-card-hover); border-color: rgba(124, 196, 255, 0.45); color: #fff; }
 .kb-sort:focus-visible { outline: 2px solid var(--kb-accent); outline-offset: 3px; }
 .kb-gallery { max-width: 1200px; margin: 0 auto; padding: 8px 24px 40px; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px; }
 .kb-card {
   appearance: none;
   text-align: left;
   padding: 0;
   border: 1px solid var(--kb-border);
   border-radius: 16px;
   background: var(--kb-card);
   color: inherit;
   font: inherit;
   cursor: pointer;
   overflow: hidden;
   transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
 }
 .kb-card:hover { transform: translateY(-4px); background: var(--kb-card-hover); border-color: rgba(124, 196, 255, 0.35); box-shadow: 0 20px 44px -20px rgba(0, 0, 0, 0.95); }
 .kb-card:focus-visible { outline: 2px solid var(--kb-accent); outline-offset: 3px; }
 .kb-media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: linear-gradient(135deg, #1b2738, #0e141d); }
 .kb-thumb { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.45s ease; }
 .kb-card:hover .kb-thumb { transform: scale(1.06); }
 .kb-play {
   position: absolute;
   inset: 0;
   margin: auto;
   width: 62px;
   height: 62px;
   display: grid;
   place-items: center;
   border-radius: 50%;
   background: rgba(10, 13, 18, 0.55);
   border: 1px solid rgba(255, 255, 255, 0.28);
   backdrop-filter: blur(6px);
   -webkit-backdrop-filter: blur(6px);
   transition: transform 0.25s ease, background 0.25s ease;
 }
 .kb-play svg { width: 24px; height: 24px; fill: #ffffff; margin-left: 3px; }
 .kb-card:hover .kb-play { transform: scale(1.1); background: rgba(124, 196, 255, 0.9); }
 .kb-card:hover .kb-play svg { fill: #06121f; }
 .kb-kind { position: absolute; left: 10px; top: 10px; padding: 3px 9px; border-radius: 999px; background: rgba(6, 9, 13, 0.82); color: #cfe0f5; font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.09em; }
 .kb-duration { position: absolute; right: 10px; bottom: 10px; padding: 3px 8px; border-radius: 6px; background: rgba(6, 9, 13, 0.82); color: #dfe8f3; font-size: 0.76rem; font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
 .kb-info { display: block; padding: 14px 16px 16px; }
 .kb-title { display: block; font-size: 1.03rem; font-weight: 600; letter-spacing: -0.01em; }
 .kb-outlet { display: block; margin-top: 5px; color: var(--kb-accent); font-size: 0.83rem; }
 .kb-date { display: block; margin-top: 3px; color: var(--kb-muted); font-size: 0.85rem; }
 .kb-dialog { border: none; padding: 0; background: transparent; width: min(1100px, 94vw); max-width: min(1100px, 94vw); }
 .kb-dialog::backdrop { background: rgba(4, 6, 10, 0.82); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
 .kb-dialog-inner { background: #0b0f16; border: 1px solid var(--kb-border); border-radius: 18px; overflow: hidden; box-shadow: 0 44px 110px -34px #000; }
 .kb-dialog-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 18px; }
 .kb-dialog-title { font-weight: 600; }
 .kb-close { appearance: none; border: 1px solid var(--kb-border); background: transparent; color: var(--kb-text); width: 34px; height: 34px; border-radius: 50%; cursor: pointer; font-size: 0.95rem; line-height: 1; }
 .kb-close:hover { background: rgba(255, 255, 255, 0.09); }
 .kb-dialog-nav { display: flex; align-items: center; gap: 8px; }
 .kb-nav { appearance: none; border: 1px solid var(--kb-border); background: transparent; color: var(--kb-text); width: 34px; height: 34px; border-radius: 50%; cursor: pointer; font-size: 1rem; line-height: 1; }
 .kb-nav:hover { background: rgba(255, 255, 255, 0.09); }
 .kb-stage { position: relative; background: #000; }
 .kb-player { width: 100%; max-height: 78vh; display: block; background: #000; }
 .kb-audio { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px; padding: 40px 28px 34px; background: radial-gradient(620px 340px at 50% 0%, rgba(124, 196, 255, 0.14), transparent 72%), #0b0f16; }
 .kb-audio-art { width: min(340px, 68vw); border-radius: 14px; display: block; box-shadow: 0 26px 64px -26px #000; }
 .kb-audio-el { width: min(560px, 92%); }
 .kb-arrow {
   position: absolute;
   top: 50%;
   transform: translateY(-50%);
   width: 52px;
   height: 52px;
   display: grid;
   place-items: center;
   padding: 0;
   border: 1px solid rgba(255, 255, 255, 0.3);
   border-radius: 50%;
   background: rgba(10, 13, 18, 0.55);
   color: #ffffff;
   cursor: pointer;
   backdrop-filter: blur(6px);
   -webkit-backdrop-filter: blur(6px);
   transition: background 0.2s ease, transform 0.2s ease;
 }
 .kb-arrow svg { width: 26px; height: 26px; }
 .kb-arrow:hover { background: rgba(124, 196, 255, 0.9); color: #06121f; }
 .kb-arrow:active { transform: translateY(-50%) scale(0.92); }
 .kb-arrow:focus-visible { outline: 2px solid var(--kb-accent); outline-offset: 3px; }
 .kb-arrow-prev { left: 14px; }
 .kb-arrow-next { right: 14px; }
 .kb-dialog-foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
 .kb-dialog-foot a { display: inline-block; padding: 12px 8px 16px; color: var(--kb-muted); font-size: 0.85rem; text-decoration: none; }
 .kb-dialog-foot a:hover { color: var(--kb-accent); }
 .kb-foot-links { display: inline-flex; align-items: center; gap: 4px; }
 .kb-foot-links a:first-child { padding-left: 18px; }
 .kb-hint { padding: 12px 18px 16px; color: var(--kb-muted); font-size: 0.8rem; }
 .kb-footer { max-width: 1200px; margin: 0 auto; padding: 24px; text-align: center; color: var(--kb-muted); font-size: 0.85rem; border-top: 1px solid var(--kb-border); }
 .kb-footer a { color: var(--kb-accent); text-decoration: none; }
 .kb-footer a:hover { text-decoration: underline; }
 .kb-noscript { max-width: 620px; margin: 0 auto; padding: 0 24px 32px; text-align: center; color: var(--kb-muted); }
 @media (max-width: 640px) {
   .kb-hero { padding-top: 52px; }
   .kb-toolbar { padding-top: 18px; }
   .kb-gallery { grid-template-columns: 1fr; gap: 18px; }
   .kb-hint { display: none; }
 }
 @media (pointer: coarse) {
   .kb-hint { display: none; }
 }
 @media (prefers-reduced-motion: reduce) {
   * { transition: none !important; }
 }

<header class="kb-hero">
 <a href="https://knowbooks.com" class="kb-kicker">knowbooks.com</a>
 <h1>In the Media</h1>
 <p class="kb-sub">Every place Knowbooks shows up in the media.</p>
</header>

<div class="kb-toolbar">
 <span class="kb-count" id="kb-count"></span>
 <button class="kb-sort" id="kb-sort" type="button" aria-label="Sort by date: Newest first">Newest first</button>
</div>

<div class="kb-gallery" id="kb-gallery">
datatable media.json
 compose kbCard <button class="kb-card" type="button" data-src="{src}" data-kind="{kind}" data-poster="{poster}" data-date="{published}" data-title="{title}" data-outlet="{outlet}" data-url="{url}" data-duration="{duration}"><span class="kb-media"><img class="kb-thumb" src="{poster}" alt="{title}" loading="lazy" decoding="async" width="640" height="360"><span class="kb-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="kb-kind">{kindLabel}</span><span class="kb-duration">{duration}</span></span><span class="kb-info"><span class="kb-title">{title}</span><span class="kb-outlet">{outlet}</span><span class="kb-date">{publishedLabel}</span></span></button>
  printColumn kbCard
</div>

<dialog class="kb-dialog" id="kb-dialog">
 <div class="kb-dialog-inner">
  <div class="kb-dialog-head">
   <span class="kb-dialog-title" id="kb-dialog-title"></span>
   <div class="kb-dialog-nav">
    <button class="kb-nav" id="kb-prev" type="button" aria-label="Previous appearance" title="Previous appearance (left arrow)">←</button>
    <button class="kb-nav" id="kb-next" type="button" aria-label="Next appearance" title="Next appearance (right arrow)">→</button>
    <button class="kb-close" id="kb-close" type="button" aria-label="Close player">✕</button>
   </div>
  </div>
  <div class="kb-stage">
   <video class="kb-player" id="kb-player" controls playsinline preload="none" hidden></video>
   <div class="kb-audio" id="kb-audio" hidden>
    <img class="kb-audio-art" id="kb-audio-art" alt="" loading="lazy" decoding="async">
    <audio class="kb-audio-el" id="kb-audio-el" controls preload="none"></audio>
   </div>
   <button class="kb-arrow kb-arrow-prev" id="kb-prev-overlay" type="button" aria-label="Previous appearance"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
   <button class="kb-arrow kb-arrow-next" id="kb-next-overlay" type="button" aria-label="Next appearance"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
  </div>
  <div class="kb-dialog-foot">
   <span class="kb-foot-links">
    <a id="kb-source" target="_blank" rel="noopener" hidden>Open original ↗</a>
    <a id="kb-download" download hidden>Download</a>
   </span>
   <span class="kb-hint">Use the arrows or ← → to change appearances</span>
  </div>
 </div>
</dialog>

<noscript><p class="kb-noscript">Enable JavaScript to play the media. You can still open any recording directly, for example <a href="mairi.m4a">mairi.m4a</a>.</p></noscript>

<footer class="kb-footer">
 <a href="https://knowbooks.com">knowbooks.com</a>
</footer>

player.js
